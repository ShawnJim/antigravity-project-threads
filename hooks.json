{
  "project-threads-lifecycle": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "agy-node ./scripts/hook-handler.mjs PreInvocation || node ./scripts/hook-handler.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|run_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "agy-node ./scripts/hook-handler.mjs PreToolUse || node ./scripts/hook-handler.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agy-node ./scripts/hook-handler.mjs Stop || node ./scripts/hook-handler.mjs Stop",
        "timeout": 8
      }
    ]
  }
}
