{
  "project-threads-lifecycle": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "scripts\\run-hook.cmd PreInvocation || sh ./scripts/run-hook.sh PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|run_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "scripts\\run-hook.cmd PreToolUse || sh ./scripts/run-hook.sh PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "scripts\\run-hook.cmd Stop || sh ./scripts/run-hook.sh Stop",
        "timeout": 8
      }
    ]
  }
}
